# Natural Oil ERP — backend (FastAPI + SQLAlchemy + SQLite), порт 8010.
# Контекст сборки — корень репозитория (compose: context ./src),
# поэтому пути начинаются с backend/.
#
# Python 3.12, а не 3.13: под 3.13 у psycopg2-binary==2.9.9 из
# requirements.txt нет готового колеса и pip начинает собирать его из
# исходников (нужен компилятор и заголовки libpq).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app/ ./app/

# База лежит в /app/data — это том naturaloil_api-data.
# DATABASE_URL и остальные переменные задаёт docker-compose.yml.
RUN mkdir -p /app/data
VOLUME ["/app/data"]

# uvicorn как PID 1 не получает SIGTERM вовремя — иначе stop ждёт 10 с
STOPSIGNAL SIGINT
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010", "--proxy-headers"]
