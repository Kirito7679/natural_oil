# Скопировать в /opt/naturaloil/.env и заполнить. В git не кладётся.
# Проще не заполнять руками, а запустить infra/vds/setup-env.sh — он
# сгенерирует ключи сам и покажет пароль входа.

# Подпись JWT. Без неё docker compose не запустится (специально: пустой
# ключ подписи хуже отсутствующего). Сгенерировать: openssl rand -hex 32
NOP_SECRET_KEY=

# Публичный адрес панели — идёт в CORS backend'а.
# Временный: https://oil.46-8-195-117.sslip.io
# Боевой:    https://naturaloilerp.uz
NOP_FRONTEND_URL=https://oil.46-8-195-117.sslip.io

# Основной пользователь (раҳбар). Создаётся ТОЛЬКО если база пуста.
# На базе с данными seed его не трогает и пароль НЕ меняет.
NOP_MAIN_USER_NAME=Хумоюн
NOP_MAIN_USER_LOGIN=95 810 06 00
NOP_MAIN_USER_PASSWORD=

# Срок жизни токена входа, минут (по умолчанию 480 = 8 часов)
NOP_TOKEN_MINUTES=480
